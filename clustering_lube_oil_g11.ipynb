        "from sklearn.metrics import silhouette_score\n",
        "from sklearn.cluster import DBSCAN\n",
        "import numpy as np\n",
        "\n",
        "best_score = -1\n",
        "best_params = None\n",
        "\n",
        "for eps in np.arange(0.3, 1.2, 0.1):\n",
        "    for min_samples in range(4, 10):\n",
        "        db = DBSCAN(eps=eps, min_samples=min_samples).fit(scaled_df_clean)\n",
        "        labels = db.labels_\n",
        "        # Only consider clusters with more than one point for silhouette score\n",
        "        unique_labels = set(labels)\n",
        "        if -1 in unique_labels:\n",
        "            unique_labels.remove(-1)\n",
        "        if len(unique_labels) > 1:\n",
        "            # Filter data and labels for silhouette score calculation\n",
        "            core_samples_mask = labels != -1\n",
        "            core_labels = labels[core_samples_mask]\n",
        "            scaled_df_clean_filtered = scaled_df_clean[core_samples_mask]\n",
        "\n",
        "            score = silhouette_score(scaled_df_clean_filtered, core_labels)\n",
        "            if score > best_score:\n",
        "                best_score = score\n",
        "                best_params = (eps, min_samples)\n",
        "            print(f\"eps={eps:.1f}, min_samples={min_samples} → silhouette={score:.3f}\")\n",
        "\n",
        "\n",
        "print(f\"\\nBest separation score: {best_score:.3f}\")\n",
        "print(f\"Optimal eps: {best_params[0]:.1f}, min_samples: {best_params[1]}\")"
      ],
