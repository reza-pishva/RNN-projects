        "\n",
        "# Silhouette Scores\n",
        "silhouette_scores = []\n",
        "k_range_sil = range(2, 11)\n",
        "for k in k_range_sil:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42)\n",
